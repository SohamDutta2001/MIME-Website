# Google Sheets — menu sync
# The spreadsheet ID is the long hash in the sheet URL.
MENU_SHEET_ID=
# The tab's gid (number after gid= in the URL when that tab is selected).
MENU_SHEET_GID=

# Google Sheets — events sync
# Defaults to MENU_SHEET_ID when blank (same spreadsheet, different tab).
EVENTS_SHEET_ID=
EVENTS_SHEET_GID=
