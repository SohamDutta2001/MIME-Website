---
import { fetchEvents } from "../../lib/events/events";

let events: Awaited<ReturnType<typeof fetchEvents>> = [];
let error: string | null = null;

try {
  events = await fetchEvents();
} catch (err) {
  error = (err as Error).message;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Debug: Events</title>
    <style>
      body { font-family: monospace; padding: 2rem; background: #111; color: #eee; }
      h1 { color: #f90; margin-bottom: 1rem; }
      .error { color: #f55; background: #300; padding: 1rem; border-radius: 4px; white-space: pre-wrap; }
      .meta { color: #aaa; margin-bottom: 1rem; }
      pre { background: #1a1a1a; padding: 1.5rem; border-radius: 6px; overflow-x: auto; font-size: 0.85rem; line-height: 1.5; }
    </style>
  </head>
  <body>
    <h1>Debug: Events</h1>

    {error ? (
      <div class="error">{error}</div>
    ) : (
      <>
        <p class="meta">
          Loaded <strong>{events.length}</strong> event(s) &mdash;
          <strong>{events.filter(e => e.active).length}</strong> active
        </p>
        <pre>{JSON.stringify(events, null, 2)}</pre>
      </>
    )}
  </body>
</html>
