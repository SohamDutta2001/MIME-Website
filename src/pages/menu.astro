---
import Layout from '~/components/Layout.astro';
import Section from '~/components/Section.astro';
import MenuCard from '~/components/MenuCard.astro';
import MenuFilter from '~/components/islands/MenuFilter.tsx';
import { WashiTape } from '~/components/islands/Scraps.jsx';
import menuRows from '~/data/mockMenuData.json';

// Category-level notes shown beneath the section heading.
const CATEGORY_NOTES: Record<string, string> = {
  'Second Bell': 'Add Milk  +₹10',
  'Curtain Call': 'Homemade · No Preservatives',
};

// Derive unique categories in the order they first appear in the sheet.
const categories: string[] = [];
for (const row of menuRows) {
  if (!categories.includes(row.category)) categories.push(row.category);
}

// Group rows by category → subcategory, preserving sheet order throughout.
type MenuItem = typeof menuRows[number];
const grouped = new Map<string, Map<string, MenuItem[]>>();
for (const row of menuRows) {
  if (!grouped.has(row.category)) grouped.set(row.category, new Map());
  const sub = row.subcategory || '';
  const subMap = grouped.get(row.category)!;
  if (!subMap.has(sub)) subMap.set(sub, []);
  subMap.get(sub)!.push(row);
}

const rotateFor = (i: number) => ((i % 5) - 2) * 0.5;
---

<Layout title="Menu" description="The menu at Art-Teas-Tree, a cafe in Salt Lake, Kolkata — tea pulled slow, coffee from south filter beans, and snacks worth pausing for.">
  {/* Events teaser — playbill notice, above the menu header */}
  <div class="pt-8 pb-6 sm:pt-10" data-reveal style="--reveal-delay: 80ms;">
    <a
      href="/events"
      class="group relative block w-full border border-tea-700/40 bg-tea-800
             -rotate-[0.5deg] px-7 py-6
             shadow-[0_4px_24px_-8px_rgba(28,20,16,0.45)]
             transition-all duration-500 ease-ink
             hover:-translate-y-0.5 hover:border-tea-500/60
             hover:shadow-[0_10px_36px_-8px_rgba(28,20,16,0.55)]
             focus-visible:outline focus-visible:outline-2
             focus-visible:outline-offset-2 focus-visible:outline-tea-300"
    >
      <WashiTape className="-top-3 left-6" color="#6B2D2D" width={72} rotate={-3} style={{}} />
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-typewriter text-[9px] uppercase tracking-[0.45em] text-tea-400/60">
            Now on stage
          </p>
          <p class="mt-4 font-body text-base leading-7 text-tea-200/70">
            Beyond the menu, the café becomes a stage for performances, readings,
            workshops and gatherings all month long.
          </p>
          <p class="mt-3 font-typewriter text-[10px] uppercase tracking-[0.3em] text-tea-400/55"
             aria-hidden="true">
            First Stage · Third Space · Café Events
          </p>
          <p class="mt-4 font-hand text-2xl leading-tight text-cream transition-colors
                     duration-300 ease-ink group-hover:text-tea-100 sm:text-3xl">
            Explore upcoming events →
          </p>
        </div>
        <p class="hidden shrink-0 select-none font-bn text-4xl text-tea-500/25 sm:block"
           aria-hidden="true">
          মঞ্চ
        </p>
      </div>
    </a>
  </div>

  <header class="pt-12 sm:pt-16">
    <p class="font-hand text-lg text-tea-500">A tea-stained page</p>
    <h1 class="mt-2 text-balance font-serif text-display-xl font-medium text-tea-900">The Menu</h1>
    <p class="mt-6 max-w-prose font-body text-lg leading-relaxed text-tea-700">
      Everything here is made slow. Tea is steeped, not steamed. Coffee is pulled, not poured.
      Snacks come out when they're done, not when you ordered.
    </p>
  </header>

  {menuRows.length > 0 && (
    <div class="mt-10">
      <MenuFilter categories={categories} client:visible />
    </div>
  )}

  <div class="ink-divider mt-16" aria-hidden="true" />

  {categories.length === 0 ? (
    <Section>
      <p class="font-hand text-2xl text-tea-500 text-center py-12">
        Nothing on the menu yet — ask us what's brewing.
      </p>
    </Section>
  ) : categories.map(cat => {
    const subMap = grouped.get(cat)!;
    const note = CATEGORY_NOTES[cat];
    let cardIndex = 0;
    return (
      <Section id={cat.toLowerCase().replace(/\s+/g, '-')}>
        <header class="mb-8 max-w-prose">
          <h2 class="font-serif text-display-md font-medium text-tea-900">{cat}</h2>
          {note && <p class="mt-1 font-typewriter text-xs uppercase tracking-[0.2em] text-tea-500">{note}</p>}
        </header>
        {Array.from(subMap.entries()).map(([sub, items]) => (
          <div class="mb-8">
            {sub && (
              <h3 class="mb-4 font-serif text-xl italic text-tea-700 border-b border-tea-500/20 pb-2">{sub}</h3>
            )}
            <div class="grid gap-5 sm:grid-cols-2 md:gap-6">
              {items.map((item) => {
                const rotate = rotateFor(cardIndex++);
                return (
                  <MenuCard
                    name={item.itemName}
                    price={item.price}
                    priceDisplay={item.priceDisplay}
                    description={item.description}
                    category={item.category}
                    rotate={rotate}
                  />
                );
              })}
            </div>
          </div>
        ))}
      </Section>
    );
  })}

  <Section align="center" divider>
    <p class="mx-auto max-w-prose font-body text-tea-700">
      Prices are in rupees, inclusive of tax. We accept cash, cards, and UPI.
      A small bowl of nimki appears at every table on its own.
    </p>
  </Section>

  <div class="pb-20 pt-6 sm:pb-28">
    <div class="ink-divider mb-14" aria-hidden="true" />

    <div class="relative mx-auto max-w-2xl">

      <WashiTape className="-top-3 left-1/2 -translate-x-1/2" color="#C9A87A" width={112} rotate={2} style={{}} />

      <div
        class="relative bg-[#F5F0E6] px-8 py-10 shadow-[0_26px_60px_-18px_rgba(0,0,0,0.18)] sm:px-10"
        style="transform: rotate(-0.8deg);"
      >
        <p class="font-typewriter text-[10px] uppercase tracking-[0.32em] text-tea-500">
          Donate a book
        </p>

        <h2 class="mt-2 font-hand text-3xl leading-snug text-tea-900 sm:text-4xl">
          Have a book looking for a new reader?
        </h2>

        <p class="mt-4 font-body text-base leading-7 text-tea-700">
          Bring it in. The shelf is always open to a new arrival. Leave it at the
          counter, or write to us first — it will find its place on our wall.
        </p>

        <div class="mt-6 flex flex-col gap-3 border-t border-tea-900/10 pt-5 sm:flex-row sm:items-center sm:justify-between">
          <a
            href="mailto:Art.teas.tree.cafe@gmail.com"
            class="inline-flex items-center gap-2 font-typewriter text-sm tracking-wide text-tea-600 underline decoration-tea-500/40 underline-offset-4 transition-colors hover:text-tea-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tea-600"
          >
            Art.teas.tree.cafe@gmail.com
          </a>
          <p class="font-typewriter text-[10px] uppercase tracking-[0.28em] text-tea-900/40">
            Walk in · Sector II, Bidhannagar, Kolkata
          </p>
        </div>
      </div>

    </div>
  </div>
</Layout>
