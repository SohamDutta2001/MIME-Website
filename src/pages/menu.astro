---
import Layout from '~/components/Layout.astro';
import Section from '~/components/Section.astro';
import MenuCard from '~/components/MenuCard.astro';
import MenuFilter from '~/components/islands/MenuFilter.tsx';
import menuRows from '~/data/mockMenuData.json';

// Category-level notes shown beneath the section heading.
const CATEGORY_NOTES: Record<string, string> = {
  'Second Bell': 'Add Milk  +₹10',
  'Curtain Call': 'Homemade · No Preservatives',
};

// Derive unique categories in the order they first appear in the sheet.
const categories: string[] = [];
for (const row of menuRows) {
  if (!categories.includes(row.category)) categories.push(row.category);
}

// Group rows by category → subcategory, preserving sheet order throughout.
type MenuItem = typeof menuRows[number];
const grouped = new Map<string, Map<string, MenuItem[]>>();
for (const row of menuRows) {
  if (!grouped.has(row.category)) grouped.set(row.category, new Map());
  const sub = row.subcategory || '';
  const subMap = grouped.get(row.category)!;
  if (!subMap.has(sub)) subMap.set(sub, []);
  subMap.get(sub)!.push(row);
}

const rotateFor = (i: number) => ((i % 5) - 2) * 0.5;
---

<Layout title="Menu" description="The menu at Art-Teas-Tree, a cafe in Salt Lake, Kolkata — tea pulled slow, coffee from south filter beans, and snacks worth pausing for.">
  <header class="pt-12 sm:pt-16">
    <p class="font-hand text-lg text-tea-500">A tea-stained page</p>
    <h1 class="mt-2 text-balance font-serif text-display-xl font-medium text-tea-900">The Menu</h1>
    <p class="mt-6 max-w-prose font-body text-lg leading-relaxed text-tea-700">
      Everything here is made slow. Tea is steeped, not steamed. Coffee is pulled, not poured.
      Snacks come out when they're done, not when you ordered.
    </p>
  </header>

  {menuRows.length > 0 && (
    <div class="mt-10">
      <MenuFilter categories={categories} client:visible />
    </div>
  )}

  <div class="ink-divider mt-16" aria-hidden="true" />

  {categories.length === 0 ? (
    <Section>
      <p class="font-hand text-2xl text-tea-500 text-center py-12">
        Nothing on the menu yet — ask us what's brewing.
      </p>
    </Section>
  ) : categories.map(cat => {
    const subMap = grouped.get(cat)!;
    const note = CATEGORY_NOTES[cat];
    let cardIndex = 0;
    return (
      <Section id={cat.toLowerCase().replace(/\s+/g, '-')}>
        <header class="mb-8 max-w-prose">
          <h2 class="font-serif text-display-md font-medium text-tea-900">{cat}</h2>
          {note && <p class="mt-1 font-typewriter text-xs uppercase tracking-[0.2em] text-tea-500">{note}</p>}
        </header>
        {Array.from(subMap.entries()).map(([sub, items]) => (
          <div class="mb-8">
            {sub && (
              <h3 class="mb-4 font-serif text-xl italic text-tea-700 border-b border-tea-500/20 pb-2">{sub}</h3>
            )}
            <div class="grid gap-5 sm:grid-cols-2 md:gap-6">
              {items.map((item) => {
                const rotate = rotateFor(cardIndex++);
                return (
                  <MenuCard
                    name={item.itemName}
                    price={item.price}
                    priceDisplay={item.priceDisplay}
                    description={item.description}
                    category={item.category}
                    rotate={rotate}
                  />
                );
              })}
            </div>
          </div>
        ))}
      </Section>
    );
  })}

  <Section align="center" divider>
    <p class="mx-auto max-w-prose font-body text-tea-700">
      Prices are in rupees, inclusive of tax. We accept cash, cards, and UPI.
      A small bowl of nimki appears at every table on its own.
    </p>
  </Section>
</Layout>
