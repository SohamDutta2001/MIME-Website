---
// Shared structure for every event page: playbill hero, description beside
// the ticket stub, a category-specific slot (artist bios / learning
// outcomes / curator notes), registration, then the gallery. The category
// templates wrap this and fill the "info" slot with their own flavour.
import Layout from '../Layout.astro';
import EventHero from './EventHero.astro';
import EventMeta from './EventMeta.astro';
import RegistrationCTA from './RegistrationCTA.astro';
import EventGallery from './EventGallery.astro';
import { paragraphs } from '~/lib/events/utils.js';
import { resolveEventImage } from '~/lib/events/images.js';
import { site } from '~/data/site';
import type { CafeEvent } from '~/types/event';

interface Props {
  event: CafeEvent;
  kicker: string;
  kickerBn: string;
}

const { event, kicker, kickerBn } = Astro.props;
const description = paragraphs(event.description);

const base = import.meta.env.BASE_URL;
const basePath = base === '/' ? '' : base.replace(/\/$/, '');

// Per-event Open Graph image + Event structured data so each event is
// shareable and eligible for Google's event rich results.
const banner = event.bannerUrl ? resolveEventImage(event.bannerUrl, { width: 1200 }) : undefined;
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: event.date,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  description: event.description?.slice(0, 300),
  ...(banner ? { image: [banner] } : {}),
  url: new URL(`${basePath}/events/${event.slug}/`, Astro.site).toString(),
  location: {
    '@type': 'Place',
    name: site.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.location.streetAddress,
      addressLocality: site.location.locality,
      addressRegion: site.location.region,
      postalCode: site.location.postalCode,
      addressCountry: site.location.country,
    },
  },
  organizer: { '@type': 'Organization', name: site.affiliation.name },
};
---

<Layout title={event.title} description={event.description.slice(0, 150)} image={banner} variant="wide">
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />

  <article class="py-10 sm:py-14">
    <EventHero event={event} kicker={kicker} kickerBn={kickerBn} />

    <div class="mt-14 grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="max-w-prose" data-reveal>
        {description.length > 0 ? (
          description.map((para, i) => (
            <p
              class:list={[
                'font-body text-lg leading-relaxed text-tea-700',
                i === 0 && 'drop-cap',
                i > 0 && 'mt-6',
              ]}
            >
              {para}
            </p>
          ))
        ) : (
          <p class="font-hand text-2xl text-tea-600" style="transform: rotate(-1deg);">
            no notes survived for this one — ask at the counter, someone will remember.
          </p>
        )}
      </div>

      <div data-reveal style="--reveal-delay: 140ms">
        <EventMeta event={event} />
      </div>
    </div>

    <!-- Category-specific section (artists / outcomes / curator) -->
    <slot name="info" />

    <div class="mt-16" data-reveal>
      <RegistrationCTA event={event} />
    </div>

    <div class="mt-16">
      <EventGallery event={event} />
    </div>

    <p class="mt-16">
      <a href={`${basePath}/events/`} class="ink-link font-body text-sm text-tea-600">
        ← back to the notice board
      </a>
    </p>
  </article>
</Layout>
