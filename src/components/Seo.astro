---
// Central SEO head: title, meta description, canonical, Open Graph + Twitter
// cards, geo tags, and the site-wide structured data (a CafeOrCoffeeShop +
// WebSite JSON-LD graph that powers Google's local/rich results). Used by both
// Layout.astro and the standalone homepage (index.astro) so every page gets a
// consistent, crawlable head.
import { site } from '~/data/site';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative image for OG/Twitter. Defaults to the social card. */
  image?: string;
  /** og:type — 'website' for most pages, 'article'/'event' where it fits. */
  type?: string;
}

const { title, description, image, type = 'website' } = Astro.props;

const fullTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — Cafe in Salt Lake, Kolkata | Tea, Coffee, Books & Adda`;
const desc = description ?? site.description;

// Astro.site is the configured origin; BASE_URL is the path prefix the site is
// served under ('/MIME-Website/' on the Pages demo, '/' on a root domain).
// `abs` resolves a root-relative path to a full, base-aware absolute URL —
// what search engines and social scrapers need. Astro.url.pathname already
// includes the base, so canonical can use it directly.
const base = import.meta.env.BASE_URL;
const abs = (path: string) => new URL(path.replace(/^\//, base), Astro.site).toString();
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image ? new URL(image, Astro.site).toString() : abs('/og-image.jpg');

const business = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CafeOrCoffeeShop',
      '@id': `${abs('/')}#cafe`,
      name: site.name,
      alternateName: 'Art Teas Tree Cafe',
      description: site.description,
      url: abs('/'),
      image: abs('/og-image.jpg'),
      email: site.contact.email,
      priceRange: '₹₹',
      servesCuisine: ['Tea', 'Coffee', 'Cafe', 'Snacks', 'Indian'],
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.location.streetAddress,
        addressLocality: site.location.locality,
        addressRegion: site.location.region,
        postalCode: site.location.postalCode,
        addressCountry: site.location.country,
      },
      areaServed: ['Salt Lake City', 'Bidhannagar', 'Kolkata'],
      sameAs: [site.contact.instagramUrl],
      hasMenu: abs('/menu/'),
      // NOTE: add a real "telephone" here once the cafe phone is live — it is
      // a strong local-SEO signal and is required for Google Business Profile.
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
          opens: '10:00',
          closes: '22:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Friday', 'Saturday'],
          opens: '10:00',
          closes: '23:30',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Sunday'],
          opens: '12:00',
          closes: '22:00',
        },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${abs('/')}#website`,
      url: abs('/'),
      name: site.name,
      description: site.description,
      inLanguage: 'en-IN',
      publisher: { '@id': `${abs('/')}#cafe` },
    },
  ],
};
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large" />

{/* Local search hints */}
<meta name="geo.region" content="IN-WB" />
<meta name="geo.placename" content="Salt Lake City, Kolkata" />

{/* Open Graph */}
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_IN" />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(business)} />
